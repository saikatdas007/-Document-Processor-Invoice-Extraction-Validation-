# Generate a unique value with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET_KEY=
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Optional. Set both values to provision an administrator account on API startup.
AUTH_INITIAL_ADMIN_EMAIL=
AUTH_INITIAL_ADMIN_PASSWORD=

# Optional for local invoice extraction.
OPENAI_API_KEY=

# Optional persistent caches for deployments.
HF_HOME=
TESSERACT_CACHE_PATH=

# Optional Qdrant Cloud vector search. When configured, stored SQLite embeddings
# are copied into this collection during API startup.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=document_embeddings
